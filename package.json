{
  "name": "bookmarklets",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Bookmarklets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelfullerthomas/bookmarklets.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node --watch-path=bookmarklets --watch-path=scripts scripts/build.js",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run lint && npm run typecheck && npm run format:check && node --test"
  },
  "author": "Sam Thomas",
  "license": "ISC",
  "homepage": "https://github.com/samuelfullerthomas/bookmarklets",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "markdown-it": "15.0.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "type": "module"
}
